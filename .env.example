# TRUSTLINE Production & Local PostgreSQL Connection
DATABASE_URL="postgresql://username:password@localhost:5432/trustline_db?schema=public"

# Server Host & App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OpenAI API Key for Copilot LLM Synthesis
# OPENAI_API_KEY="your-openai-api-key-here"

# Authentication Secret Token
JWT_SECRET="replace-with-a-long-random-secret"

# FCIRP model runtime (required when deploying with the ML prioritization feature)
FCIRP_MODEL_PATH="/app/models/fcirp/case_priority.pkl"
FCIRP_PYTHON="/opt/fcirp-venv/bin/python"

# Optional demo bootstrap controls for a hosted demonstration instance
ENABLE_DEMO_BOOTSTRAP="false"
DEMO_EMPLOYEE_PASSWORD="replace-with-a-strong-demo-password"
DEMO_INVESTIGATOR_PASSWORD="replace-with-a-strong-demo-password"
